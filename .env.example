# ==============================================================================
# CONFIGURAÇÕES DO SISTEMA (CICC - Calculadora de Emissões de Carbono)
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados
# ------------------------------------------------------------------------------
# Tipo de banco de dados: 'sqlite' (recomendado para totens/local) ou 'postgres'
DB_TYPE=sqlite

# Nome do arquivo SQLite (utilizado apenas se DB_TYPE=sqlite)
SQLITE_FILE=database.sqlite3

# Credenciais do PostgreSQL (utilizadas apenas se DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=emissions_db
DB_USER=postgres
DB_PASSWORD=strong_password

# ------------------------------------------------------------------------------
# 2. Segurança & Administração do Totem
# ------------------------------------------------------------------------------
# PIN de 4 ou mais dígitos para autenticar o download do relatório CSV
# Usado tanto no modal dos 5 cliques na logo quanto no endpoint /api/emission/export
ADMIN_PIN=1234

# ------------------------------------------------------------------------------
# 3. Servidor Web
# ------------------------------------------------------------------------------
# Porta de execução da aplicação (Flask / Waitress)
PORT=5000